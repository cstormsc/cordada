# Copy to .env (make does it on first run). Never commit .env.
DJANGO_SECRET_KEY=change-me-local-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# To share this machine through a Cloudflare tunnel (see README), use instead:
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://*.trycloudflare.com
# DJANGO_BEHIND_HTTPS_PROXY=true
TIME_ZONE=UTC

POSTGRES_DB=cordada
POSTGRES_USER=cordada
POSTGRES_PASSWORD=cordada
DATABASE_URL=postgres://cordada:cordada@db:5432/cordada

# Automatic backups to ./backups (database + uploaded files)
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14

# Parte B §13 defaults
FORMULARIOS_ENLACE_DIAS=60
DATA_RETENTION_YEARS=5

EMAIL_URL=smtp://mailpit:1025
DEFAULT_FROM_EMAIL=Cordada <no-reply@cordada.local>
