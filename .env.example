# Copy to .env (make does it on first run). Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-local-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC

POSTGRES_DB=cordada
POSTGRES_USER=cordada
POSTGRES_PASSWORD=cordada
DATABASE_URL=postgres://cordada:cordada@db:5432/cordada

EMAIL_URL=smtp://mailpit:1025
DEFAULT_FROM_EMAIL=Cordada <no-reply@cordada.local>
